#!/usr/bin/env bash
set -euo pipefail

SERVICE=oculizer.service
CONFIG=/etc/oculizer/deployment.json

run_systemctl() {
  sudo -n /usr/bin/systemctl "$@" "$SERVICE"
}

command=${1:-}
option=${2:-}
if [[ -n $option && $option != --no-web ]]; then
  echo "oculizer-service: unsupported option '$option'" >&2
  exit 1
fi

case "$command" in
  start)
    if [[ $option == --no-web ]]; then
      sudo -n /usr/bin/systemctl set-environment OCULIZER_NO_WEB=1
      trap 'sudo -n /usr/bin/systemctl unset-environment OCULIZER_NO_WEB' EXIT
    else
      sudo -n /usr/bin/systemctl unset-environment OCULIZER_NO_WEB
    fi
    run_systemctl start
    ;;
  stop)
    run_systemctl stop
    ;;
  restart)
    if [[ $option == --no-web ]]; then
      sudo -n /usr/bin/systemctl set-environment OCULIZER_NO_WEB=1
      trap 'sudo -n /usr/bin/systemctl unset-environment OCULIZER_NO_WEB' EXIT
    else
      sudo -n /usr/bin/systemctl unset-environment OCULIZER_NO_WEB
    fi
    run_systemctl restart
    ;;
  status)
    /usr/bin/systemctl status "$SERVICE" --no-pager
    ;;
  logs)
    /usr/bin/journalctl -u "$SERVICE" -f
    ;;
  run-auto)
    [[ -r $CONFIG ]] || { echo "oculizer-service: missing $CONFIG" >&2; exit 1; }
    echo "Starting Oculizer in foreground diagnostic mode..."
    if ! /usr/bin/python3 /usr/local/lib/oculizer-deploy/wait_for_qlc.py; then
      echo "oculizer-service: startup cancelled because QLC+ is unavailable." >&2
      echo "Use 'oculizer-service status' and 'oculizer-service logs' for systemd diagnostics." >&2
      exit 1
    fi
    export OCULIZER_CONTROL_SOCKET="${XDG_RUNTIME_DIR:-/tmp}/oculizer-$(id -u).sock"
    [[ $option == --no-web ]] && export OCULIZER_NO_WEB=1
    echo "QLC+ readiness passed; starting Oculizer. Press Ctrl+C to stop."
    exec /usr/bin/python3 /usr/local/lib/oculizer-deploy/run_oculizer.py
    ;;
  auto)
    [[ -z $option ]] || { echo "oculizer-service: --no-web is not supported with auto; reinstall with install.sh --no-web" >&2; exit 1; }
    sudo -n /usr/bin/systemctl unset-environment OCULIZER_NO_WEB
    sudo -n /usr/bin/systemctl enable --now "$SERVICE"
    echo "Oculizer auto-start enabled and service started."
    ;;
  noauto)
    run_systemctl disable
    echo "Oculizer auto-start disabled; the current process state was not changed."
    ;;
  last-state)
    echo "Enabled: $(/usr/bin/systemctl is-enabled "$SERVICE" 2>/dev/null || true)"
    echo "Active : $(/usr/bin/systemctl is-active "$SERVICE" 2>/dev/null || true)"
    ;;
  health)
    exec /usr/local/bin/oculizerctl status
    ;;
  *)
    echo "Usage: oculizer-service {start|restart|run-auto} [--no-web] | {stop|status|logs|auto|noauto|last-state|health}" >&2
    exit 1
    ;;
esac

[Unit]
Description=Oculizer headless audio-reactive lighting service
After=network.target sound.target
Wants=network.target sound.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
Environment=HOME=@SERVICE_HOME@
Environment=XDG_RUNTIME_DIR=/run/user/@SERVICE_UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@SERVICE_UID@/bus
RuntimeDirectory=oculizer
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/python3 /usr/local/lib/oculizer-deploy/wait_for_qlc.py
ExecStart=/usr/bin/python3 /usr/local/lib/oculizer-deploy/run_oculizer.py
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target

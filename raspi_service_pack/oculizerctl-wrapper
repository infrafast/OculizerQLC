#!/usr/bin/env bash
set -euo pipefail
config=/etc/oculizer/deployment.json
[[ -r $config ]] || { echo "oculizerctl: missing $config" >&2; exit 1; }
repo=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["repository"])' "$config")
exec "$repo/.venv/bin/python" "$repo/oculizerctl.py" "$@"

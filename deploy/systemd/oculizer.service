[Unit]
Description=Oculizer headless audio-reactive lighting service
Requires=oculizer-qlc.service
After=oculizer-qlc.service sound.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
Environment=HOME=@SERVICE_HOME@
RuntimeDirectory=oculizer
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/python3 /usr/local/lib/oculizer-deploy/wait_for_qlc.py
ExecStart=/usr/bin/python3 /usr/local/lib/oculizer-deploy/run_oculizer.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target

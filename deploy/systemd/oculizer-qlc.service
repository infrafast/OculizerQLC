[Unit]
Description=Oculizer QLC+ 5 lighting engine
After=network.target sound.target
Wants=network.target sound.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
Environment=HOME=@SERVICE_HOME@
ExecStart=/usr/bin/python3 /usr/local/lib/oculizer-deploy/run_qlc.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
